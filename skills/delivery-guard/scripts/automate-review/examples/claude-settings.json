{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "{{HOOKS_DIR}}/hooks/post-push-review.sh",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
